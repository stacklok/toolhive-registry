            "pg_psql",
            "pg_info",
            "pg_ps",
            "pg_locks",
            "pg_outliers",
            "pg_credentials",
            "pg_kill",
            "pg_maintenance",
            "pg_backups",
            "pg_upgrade"
          ]
        }
      }
