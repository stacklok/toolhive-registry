    }
  ],
  "name": "io.github.stacklok/crowdstrike-falcon",
  "packages": [
    {
      "environmentVariables": [
        {
          "description": "CrowdStrike API client ID",
          "isRequired": true,
          "isSecret": true,
          "name": "FALCON_CLIENT_ID"
        },
        {
          "description": "CrowdStrike API client secret",
          "isRequired": true,
          "isSecret": true,
          "name": "FALCON_CLIENT_SECRET"
        },
        {
          "description": "CrowdStrike API base URL (optional; defaults to https://api.crowdstrike.com). Region-specific, e.g. https://api.us-2.crowdstrike.com, https://api.eu-1.crowdstrike.com",
          "name": "FALCON_BASE_URL"
        },
        {
          "description": "Comma-separated list of modules to enable (cases,cloud,correlation_rules,custom_ioa,data_protection,detections,discover,exclusions,firewall,host_groups,hosts,idp,intel,ioc,ngsiem,policies,quarantine,recon,rtr,scheduled_reports,sensor_usage,serverless,shield,spotlight). If not set, all modules are enabled, including write/action-capable ones (rtr, quarantine, firewall, policies, custom_ioa, exclusions, correlation_rules, host_groups). Scope this for least-privilege deployments.",
          "name": "FALCON_MCP_MODULES"
        },
        {
          "description": "Enable dynamic mode: exposes only 3 discovery/execution tools instead of every enabled module's tools, to reduce context window usage (true/false, default: false)",
          "name": "FALCON_MCP_DYNAMIC"
        },
        {
          "description": "Enable debug logging - true or false (default: false)",
          "name": "FALCON_MCP_DEBUG"
        },
        {
          "description": "API key required in the x-api-key header for HTTP transport authentication (optional, recommended since the server listens on 0.0.0.0)",
          "isSecret": true,
          "name": "FALCON_MCP_API_KEY"
        },
        {
          "description": "Child CID for Flight Control (MSSP) support (optional)",
          "name": "FALCON_MEMBER_CID"
        }
      ],
      "identifier": "quay.io/crowdstrike/falcon-mcp:0.16.1",
      "registryType": "oci",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000"
      }
    }
