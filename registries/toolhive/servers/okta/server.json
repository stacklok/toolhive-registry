  "packages": [
    {
      "environmentVariables": [
        {
          "description": "Okta organization URL (e.g. https://dev-123456.okta.com)",
          "isRequired": true,
          "isSecret": false,
          "name": "OKTA_ORG_URL"
        },
        {
          "description": "Client ID of the Okta application configured for this server",
          "isRequired": true,
          "isSecret": false,
          "name": "OKTA_CLIENT_ID"
        },
        {
          "description": "Space-separated OAuth 2.0 scopes granted to the application; only tools covered by these scopes are registered at startup (example: \"okta.users.read okta.groups.read\")",
          "isRequired": true,
          "isSecret": false,
          "name": "OKTA_SCOPES"
        },
        {
          "description": "RSA private key (PEM) for Private Key JWT authentication. Required in this containerized deployment since the alternative device-authorization flow needs an interactive browser",
          "isRequired": true,
          "isSecret": true,
          "name": "OKTA_PRIVATE_KEY"
        },
        {
          "description": "Key ID of the public key registered on the Okta application, paired with OKTA_PRIVATE_KEY",
          "isRequired": true,
          "isSecret": false,
          "name": "OKTA_KEY_ID"
        },
        {
          "description": "Logging verbosity, e.g. DEBUG (optional)",
          "isRequired": false,
          "isSecret": false,
          "name": "OKTA_LOG_LEVEL"
        }
      ],
