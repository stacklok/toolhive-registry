              "name": "list_services"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Returns the PCP metrics guide: a catalog of the metric names recorded on a typical Linux system, and how to read the values the other PCP tools return. Read it before investigating performance with PCP, and take metric names from it rather than from memory.",
              "inputSchema": {
                "properties": {
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "host"
                ],
                "type": "object"
              },
              "name": "pcp_guide"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Browses the PCP metric namespace. Lists the metrics under 'prefix' with their descriptions, collapsing any large sub-namespace to one line giving its name and how many metrics it holds; call again with that name as the prefix to see inside it. Only metrics this system's pmlogger records are listed, so everything listed can be passed to pcp_query_metrics. The pcp_guide tool already names the commonly needed metrics, so reach for this when you need a subsystem the guide does not cover. Use only if get_system_information() indicates PCP is available.",
              "inputSchema": {
                "properties": {
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  },
                  "prefix": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Namespace to list, such as 'mem' or 'disk.dev'. Omit it to see the top-level namespaces, which is where to start when you do not know the name.",
                    "examples": [
                      "mem",
                      "disk.dev",
                      "network.interface"
                    ]
                  }
                },
                "required": [
                  "host"
                ],
                "type": "object"
              },
              "name": "pcp_list_metrics"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Produces a condensed snapshot of CPU, memory, disk, network, and process information using pcp xsos. Can summarize the live system or a particular time in the past. Use only if get_system_information() indicates PCP is available.",
              "inputSchema": {
                "properties": {
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  },
                  "timestamp": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Optional summary timestamp: a full date and time (e.g., '2026-08-14 14:00:00'), or 'now'. Timestamps without a UTC offset are read in the target system's timezone. If not provided, shows live system summary."
                  }
                },
                "required": [
                  "host"
                ],
                "type": "object"
              },
              "name": "pcp_performance_summary"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Retrieves historical metric data from PCP archives as JSON samples. When start_time, end_time, or interval is omitted, reasonable defaults are chosen, targeting one hour or about 20 samples. Call pcp_guide first for the metric catalog and how to read the values; do not guess metric names. Use only if get_system_information() indicates PCP is available.",
              "inputSchema": {
                "properties": {
                  "end_time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "End time as a full date and time (e.g., '2026-08-14 16:00:00'), or 'now'. Timestamps without a UTC offset are read in the target system's timezone."
                  },
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  },
                  "interval": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Sampling interval (e.g., '1minute', '10seconds', '5minutes')."
                  },
                  "metrics": {
                    "description": "List of PCP metric names to query",
                    "examples": [
                      [
                        "kernel.all.cpu.user",
                        "kernel.all.cpu.sys",
                        "mem.util.used"
                      ]
                    ],
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "start_time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Start time as a full date and time (e.g., '2026-08-14 14:00:00'), or 'now'. Timestamps without a UTC offset are read in the target system's timezone."
                  }
                },
                "required": [
                  "metrics",
                  "host"
                ],
                "type": "object"
              },
              "name": "pcp_query_metrics"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Read the contents of a text file up to a safe size limit.",
              "inputSchema": {
                "properties": {
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  },
                  "path": {
                    "description": "Absolute path to the file to read",
                    "examples": [
                      "/etc/hosts",
                      "/etc/resolv.conf",
                      "/etc/os-release",
                      "/proc/cpuinfo"
                    ],
                    "format": "path",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "host"
                ],
                "type": "object"
              },
              "name": "read_file"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Read a specific log file.",
              "inputSchema": {
                "properties": {
                  "first_lines": {
                    "anyOf": [
                      {
                        "maximum": 10000,
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Number of first lines to retrieve from the log file. Mutually exclusive with last_lines."
                  },
                  "host": {
                    "description": "Remote system to connect to via SSH",
                    "examples": [
                      "web1.example.com"
                    ],
                    "type": "string"
                  },
                  "last_lines": {
                    "anyOf": [
                      {
                        "maximum": 10000,
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Number of last lines to retrieve from the log file. Default: 100. Mutually exclusive with first_lines."
                  },
                  "log_path": {
                    "description": "Absolute path to the log file (must be in allowed list)",
                    "examples": [
                      "/var/log/messages",
                      "/var/log/secure",
                      "/var/log/audit/audit.log",
                      "/var/log/dnf.log"
                    ],
                    "format": "path",
                    "type": "string"
                  }
                },
                "required": [
                  "log_path",
                  "host"
                ],
                "type": "object"
              },
              "name": "read_log_file"
            }
          ],
          "tools": [
            "get_cpu_information",
            "get_disk_usage",
            "get_hardware_information",
            "get_journal_logs",
