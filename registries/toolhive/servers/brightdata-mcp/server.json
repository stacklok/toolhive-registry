{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.stacklok": {
        "ghcr.io/stacklok/dockyard/npx/brightdata-mcp:4.1.0": {
          "metadata": {
            "last_updated": "2026-10-23T05:00:45Z",
            "stars": 2551
          },
          "overview": "## Bright Data MCP Server\n\nThe brightdata-mcp server is a Model Context Protocol (MCP) server that enables AI assistants and agents to access real-time web data through Bright Data's global proxy and scraping infrastructure. It allows AI workflows to fetch live web content, extract structured data, and perform large-scale web data collection without building or maintaining custom scraping systems. This makes it ideal for research, market analysis, competitive intelligence, and any AI-driven workflow that depends on fresh, publicly available web data.",
          "permissions": {
            "network": {
              "outbound": {
                "allow_host": [
                  "api.brightdata.com",
                  "brightdata.com",
                  "brd.superproxy.io"
                ],
                "allow_port": [
                  443,
                  80,
                  9222
                ]
              }
            }
          },
          "provenance": {
            "cert_issuer": "https://token.actions.githubusercontent.com",
            "repository_uri": "https://github.com/stacklok/dockyard",
            "runner_environment": "github-hosted",
            "signer_identity": "/.github/workflows/build-containers.yml",
            "sigstore_url": "tuf-repo-cdn.sigstore.dev"
          },
          "status": "Active",
          "tags": [
            "web-scraping",
            "data-extraction",
            "api",
            "automation",
            "browser"
          ],
          "tier": "Official",
          "tool_definitions": [
            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false,
                "readOnlyHint": true,
                "title": "Ask Bright Data Assistant"
              },
              "description": "Ask Bright Data's support assistant (Sophie) a question about Bright Data products, APIs, MCP usage, zones, scraping, or account setup. Use when the user asks \"how do I...\" about Bright Data, when you hit a Bright Data error you don't recognize, or when deciding between products (Web Unlocker vs. Scraping Browser vs. dataset tools). Supports threaded follow-ups via dialog_id.",
              "inputSchema": {
                "properties": {
                  "dialog_id": {
                    "description": "Optional 24-char dialog_id from a previous call to continue the same thread.",
                    "maxLength": 24,
                    "minLength": 24,
                    "type": "string"
                  },
                  "question": {
                    "description": "The question to ask. Max 20480 chars.",
                    "maxLength": 20480,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "question"
                ],
                "type": "object"
              },
              "name": "ask_brightdata_assistant"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": true,
                "readOnlyHint": false,
                "title": "Chatgpt Ai Insights"
              },
              "description": "Send a prompt to ChatGPT and get back AI-generated insights.\nReturns structured answer text, citations, recommendations, and markdown. Useful for GEO and LLM as a judge.",
              "inputSchema": {
                "properties": {
                  "prompt": {
                    "type": "string"
                  }
                },
                "required": [
                  "prompt"
                ],
                "type": "object"
              },
              "name": "chatgpt_ai_insights"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": true,
                "readOnlyHint": true,
