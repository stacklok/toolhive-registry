              "description": "Wait for an element to be visible using its ref from the ARIA snapshot.\nUse scraping_browser_snapshot first to get the correct ref values.\nThis is more reliable than CSS selectors.",
              "inputSchema": {
                "properties": {
                  "element": {
                    "description": "Description of the element being waited for",
                    "type": "string"
                  },
                  "ref": {
                    "description": "The ref attribute from the ARIA snapshot (e.g., \"23\")",
                    "type": "string"
