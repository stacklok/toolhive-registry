              "inputSchema": {
                "properties": {
                  "element": {
                    "description": "Description of the element being typed into for context",
                    "type": "string"
                  },
                  "ref": {
                    "description": "The ref attribute from the ARIA snapshot (e.g., \"23\")",
                    "type": "string"
                  },
                  "submit": {
                    "description": "Whether to submit the form after typing (press Enter)",
                    "type": "boolean"
                  },
