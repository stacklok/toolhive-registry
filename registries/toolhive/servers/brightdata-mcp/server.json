            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": true,
                "readOnlyHint": true,
                "title": "Browser Snapshot"
              },
              "description": "Capture an ARIA snapshot of the current page showing all interactive elements with their refs.\nThis provides accurate element references that can be used with ref-based tools.\nUse this before interacting with elements to get proper refs instead of guessing selectors.\nA filtered snapshot does not include page text; If necessary, call scraping_browser_get_text to read it.",
              "inputSchema": {
                "properties": {
                  "filtered": {
                    "description": "List only buttons, links and fields (default: false). Saves tokens. Use true for sensitive actions (payments, account changes) so page text cannot pose as an element.",
                    "type": "boolean"
                  }
                },
                "required": [],
                "type": "object"
              },
              "name": "scraping_browser_snapshot"
            },
            {
              "annotations": {
                "destructiveHint": true,
                "openWorldHint": true,
                "readOnlyHint": false,
                "title": "Browser Type Text"
              },
