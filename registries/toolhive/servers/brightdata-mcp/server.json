            },
            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false,
                "readOnlyHint": true,
                "title": "Search Dataset"
              },
              "description": "Search a Bright Data dataset by a filter and get matching records back directly (fast Elasticsearch-backed search; no snapshot). Use this to FIND MANY records by criteria, as opposed to run_scraper which collects fresh records by URL.\nFirst call list_dataset_fields to get valid field names.\nA filter is a tree: a group {operator:\"and\"|\"or\", filters:[...]} or a leaf {name, value, operator}. Max nesting depth 3.\nLeaf operators: =, !=, \u003c, \u003c=, \u003e, \u003e=, in, not_in, includes, not_includes, array_includes, not_array_includes, is_null, is_not_null.\nSupported dataset_id values:\n- gd_l1viktl72bvl7bjuj0: LinkedIn people profiles\n- gd_me5ppxjr2ge6icjuh0: LinkedIn people profiles (contact-enriched)\n- gd_l1vikfnt1wgvvqz95w: LinkedIn company information",
              "inputSchema": {
                "properties": {
                  "dataset_id": {
                    "enum": [
                      "gd_l1viktl72bvl7bjuj0",
                      "gd_me5ppxjr2ge6icjuh0",
                      "gd_l1vikfnt1wgvvqz95w"
                    ],
                    "type": "string"
                  },
                  "filter": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "filters": {
                            "items": {
                              "anyOf": [
                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "filters": {
                                      "items": {
                                        "anyOf": [
                                          {
                                            "additionalProperties": false,
                                            "properties": {
                                              "filters": {
                                                "items": {
                                                  "additionalProperties": false,
                                                  "properties": {
                                                    "name": {
                                                      "description": "Field name to filter on. Get valid field names from the list_dataset_fields tool.",
                                                      "type": "string"
                                                    },
                                                    "operator": {
                                                      "description": "Filter operator, one of: =, !=, \u003c, \u003c=, \u003e, \u003e=, in, not_in, includes, not_includes, array_includes, not_array_includes, is_null, is_not_null",
                                                      "type": "string"
                                                    },
                                                    "value": {
                                                      "anyOf": [
                                                        {
                                                          "type": "string"
                                                        },
                                                        {
                                                          "type": "number"
                                                        },
                                                        {
                                                          "type": "boolean"
                                                        },
                                                        {
                                                          "items": {
                                                            "type": [
                                                              "string",
                                                              "number",
                                                              "boolean"
                                                            ]
                                                          },
                                                          "type": "array"
                                                        }
                                                      ],
                                                      "description": "Value to compare against. Omit for is_null / is_not_null."
                                                    }
                                                  },
                                                  "required": [
                                                    "name",
                                                    "operator"
                                                  ],
                                                  "type": "object"
                                                },
                                                "minItems": 1,
                                                "type": "array"
                                              },
                                              "operator": {
                                                "enum": [
                                                  "and",
                                                  "or"
                                                ],
                                                "type": "string"
                                              }
                                            },
                                            "required": [
                                              "operator",
                                              "filters"
                                            ],
                                            "type": "object"
                                          },
                                          {
                                            "$ref": "#/properties/filter/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items"
                                          }
                                        ]
                                      },
