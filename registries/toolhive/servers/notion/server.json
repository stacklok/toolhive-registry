            "pulls": 40073,
            "stars": 3846
          },
          "permissions": {
            "network": {
              "outbound": {
                "allow_host": [
                  "api.notion.com"
                ],
                "allow_port": [
                  443
                ]
              }
            }
          },
          "status": "Active",
