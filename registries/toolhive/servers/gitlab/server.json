            "list_namespaces",
            "get_namespace",
            "verify_namespace",
            "get_project",
            "list_projects",
            "list_project_members",
            "list_labels",
            "get_label",
            "create_label",
            "update_label",
            "delete_label",
            "list_group_projects",
            "list_wiki_pages",
            "get_wiki_page",
            "create_wiki_page",
            "update_wiki_page",
            "delete_wiki_page",
            "get_repository_tree",
            "list_pipelines",
            "get_pipeline",
            "list_pipeline_jobs",
            "list_pipeline_trigger_jobs",
            "get_pipeline_job",
            "get_pipeline_job_output",
