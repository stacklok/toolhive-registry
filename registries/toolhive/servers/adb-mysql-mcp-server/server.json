          "overview": "## AnalyticDB for MySQL MCP Server\n\nThe adb-mysql-mcp-server provides a standardized interface that lets AI assistants interact directly with Alibaba Cloud AnalyticDB for MySQL databases through the Model Context Protocol (MCP). It enables seamless access to database metadata and SQL operations so AI workflows can query, analyze, and manage data without needing to embed database-specific logic directly in the assistant.",
          "permissions": {
            "network": {
              "outbound": {
                "insecure_allow_all": true
              }
            }
          },
          "provenance": {
            "cert_issuer": "https://token.actions.githubusercontent.com",
            "repository_uri": "https://github.com/stacklok/dockyard",
            "runner_environment": "github-hosted",
            "signer_identity": "/.github/workflows/build-containers.yml",
            "sigstore_url": "tuf-repo-cdn.sigstore.dev"
          },
          "status": "Active",
          "tags": [
            "database",
            "mysql",
            "analytics",
            "sql",
            "alibaba-cloud",
            "data-warehouse"
          ],
          "tier": "Official",
          "tool_definitions": [
            {
              "annotations": {},
              "description": "Execute a SQL query on an ADB MySQL cluster.\n\nConnection modes:\n  - Direct mode (ADB_MYSQL_USER/PASSWORD configured): region_id/db_cluster_id optional.\n  - Temporary account mode (AK/SK only): region_id/db_cluster_id required.\n\nArgs:\n    query: The SQL statement to execute.\n    region_id: Alibaba Cloud region ID, optional in direct mode.\n    db_cluster_id: Cluster ID, optional in direct mode.\n    database: Target database name (optional).\n",
              "inputSchema": {
                "properties": {
                  "database": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Database"
                  },
                  "db_cluster_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Db Cluster Id"
                  },
                  "query": {
                    "title": "Query",
                    "type": "string"
                  },
                  "region_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Region Id"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              },
              "name": "execute_sql"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Get the EXPLAIN ANALYZE actual execution plan with runtime statistics.\n\nConnection modes are the same as execute_sql.\n\nArgs:\n    query: The SQL statement to analyze.\n    region_id: Alibaba Cloud region ID, optional in direct mode.\n    db_cluster_id: Cluster ID, optional in direct mode.\n    database: Target database name (optional).\n",
              "inputSchema": {
                "properties": {
                  "database": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Database"
                  },
                  "db_cluster_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Db Cluster Id"
                  },
                  "query": {
                    "title": "Query",
                    "type": "string"
                  },
                  "region_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Region Id"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              },
              "name": "get_execution_plan"
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Get the EXPLAIN logical execution plan of a SQL query.\n\nConnection modes are the same as execute_sql.\n\nArgs:\n    query: The SQL statement to analyze.\n    region_id: Alibaba Cloud region ID, optional in direct mode.\n    db_cluster_id: Cluster ID, optional in direct mode.\n    database: Target database name (optional).\n",
              "inputSchema": {
                "properties": {
                  "database": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Database"
                  },
                  "db_cluster_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Db Cluster Id"
                  },
                  "query": {
