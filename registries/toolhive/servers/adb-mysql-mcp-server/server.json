  "name": "io.github.stacklok/adb-mysql-mcp-server",
  "packages": [
    {
      "environmentVariables": [
        {
          "description": "AnalyticDB for MySQL host address",
          "isRequired": true,
          "name": "ADB_MYSQL_HOST"
        },
        {
          "description": "AnalyticDB for MySQL port number",
          "isRequired": true,
          "name": "ADB_MYSQL_PORT"
        },
        {
          "description": "Database user for authentication",
          "isRequired": true,
          "name": "ADB_MYSQL_USER"
        },
        {
          "description": "Database password for authentication",
          "isRequired": true,
          "isSecret": true,
          "name": "ADB_MYSQL_PASSWORD"
        },
        {
          "description": "Database name to connect to (optional; can be passed per-call via the database tool argument instead)",
          "name": "ADB_MYSQL_DATABASE"
        },
        {
          "description": "Alibaba Cloud access key ID; required for the OpenAPI tool group (cluster management, diagnostics, monitoring). The OpenAPI tools are disabled if it is unset.",
          "isSecret": true,
          "name": "ALIBABA_CLOUD_ACCESS_KEY_ID"
        },
        {
          "description": "Alibaba Cloud access key secret; required for the OpenAPI tool group (cluster management, diagnostics, monitoring). The OpenAPI tools are disabled if it is unset.",
          "isSecret": true,
          "name": "ALIBABA_CLOUD_ACCESS_KEY_SECRET"
        }
      ],
