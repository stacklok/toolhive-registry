{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stacklok/uizze-remote",
  "description": "STOP UI SLOP. 800,000+ real screens and a hard finish gate for Codex and other coding agents.",
  "title": "UIZZE (Remote)",
  "repository": {
    "url": "https://github.com/uizze/uizze-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://uizze.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Enter Bearer followed by your UIZZE agent token.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/stacklok/toolhive-registry/main/registries/toolhive/servers/uizze-remote/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.stacklok": {
        "https://uizze.com/mcp": {
          "tier": "Official",
          "status": "Active",
          "tags": ["remote", "ui-design", "developer-tools", "codex", "claude-code", "cursor"],
          "tools": [
            "create_ui_design_contract",
            "get_ui_reference_brief",
            "validate_implementation_manifest",
            "search_design_patterns",
            "get_screen_design_analysis",
            "critique_implemented_ui",
            "audit_implemented_ui",
            "search_ui_references",
            "compare_ui_references",
            "search_ui_elements",
            "get_screen_reference",
            "get_app_reference_pack",
            "get_flow_reference_pack",
            "get_collection_reference_pack"
          ],
          "overview": "## STOP UI SLOP.\n\nIf your UI looks AI-generated, you've already lost the first impression. UIZZE gives Codex, Claude Code, Cursor, and Copilot 800,000+ real web and iOS interfaces, product-specific design contracts, implementation validation, deterministic audits, and a hard finish gate before generic UI ships. The endpoint uses Streamable HTTP and requires a full-access UIZZE agent token in the Authorization header.",
          "custom_metadata": {
            "author": "UIZZE",
            "homepage": "https://uizze.com",
            "license": "MIT"
          }
        }
      }
    }
  }
}
